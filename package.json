{
  "name": "motion-atlas",
  "version": "0.0.1",
  "private": true,
  "description": "Video/Digital Asset Management SaaS — monorepo",
  "scripts": {
    "dev": "pnpm --filter @motion-atlas/web dev",
    "dev:api": "cd apps/api && go run ./cmd/api",
    "dev:all": "pnpm dev & pnpm dev:api",
    "build": "pnpm --filter @motion-atlas/web build",
    "build:api": "cd apps/api && make build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "prettier": "^3.1.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.14.2"
}
